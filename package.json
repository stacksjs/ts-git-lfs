{
  "name": "ts-git-lfs",
  "type": "module",
  "version": "0.1.2",
  "description": "Git Large File Storage for TypeScript: pointer files, the batch API, and object storage.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-git-lfs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-git-lfs.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-git-lfs/issues"
  },
  "keywords": [
    "git",
    "git-lfs",
    "lfs",
    "large-file-storage",
    "typescript",
    "bun"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "git-lfs-server": "./dist/bin/cli.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun --bun build.ts && bun run compile",
    "compile": "bun build ./bin/cli.ts --compile --minify --outfile bin/git-lfs-server",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:windows-x64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-linux-x64 --outfile bin/git-lfs-server-linux-x64",
    "compile:linux-arm64": "bun build ./bin/cli.ts --compile --minify --target=bun-linux-arm64 --outfile bin/git-lfs-server-linux-arm64",
    "compile:windows-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-windows-x64 --outfile bin/git-lfs-server-windows-x64.exe",
    "compile:darwin-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-darwin-x64 --outfile bin/git-lfs-server-darwin-x64",
    "compile:darwin-arm64": "bun build ./bin/cli.ts --compile --minify --target=bun-darwin-arm64 --outfile bin/git-lfs-server-darwin-arm64",
    "zip": "bun run zip:all",
    "zip:all": "bun run zip:linux-x64 && bun run zip:linux-arm64 && bun run zip:windows-x64 && bun run zip:darwin-x64 && bun run zip:darwin-arm64",
    "zip:linux-x64": "zip -j bin/git-lfs-server-linux-x64.zip bin/git-lfs-server-linux-x64",
    "zip:linux-arm64": "zip -j bin/git-lfs-server-linux-arm64.zip bin/git-lfs-server-linux-arm64",
    "zip:windows-x64": "zip -j bin/git-lfs-server-windows-x64.zip bin/git-lfs-server-windows-x64.exe",
    "zip:darwin-x64": "zip -j bin/git-lfs-server-darwin-x64.zip bin/git-lfs-server-darwin-x64",
    "zip:darwin-arm64": "zip -j bin/git-lfs-server-darwin-arm64.zip bin/git-lfs-server-darwin-arm64",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "prepublishOnly": "bun --bun run build && bun run compile:all && bun run zip",
    "test": "bun test",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bun x --bun bumpx prompt --recursive",
    "postinstall": "bunx git-hooks",
    "dev:docs": "bun --bun bunpress dev docs",
    "build:docs": "bun --bun bunpress build docs",
    "preview:docs": "bun --bun bunpress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write",
    "release:patch": "bun x --bun bumpx patch --recursive --commit --tag --push --yes",
    "release:minor": "bun x --bun bumpx minor --recursive --commit --tag --push --yes",
    "release:major": "bun x --bun bumpx major --recursive --commit --tag --push --yes"
  },
  "devDependencies": {
    "better-dx": "^0.2.15"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
